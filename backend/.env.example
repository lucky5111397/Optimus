# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Worker Sandbox Service
WORKER_URL=http://localhost:8080

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/optimus
MONGODB_TIMEOUT_MS=5000

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# GitHub OAuth Integration & Webhooks
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Firebase Admin (Google Authentication)
FIREBASE_SERVICE_ACCOUNT_JSON=

# AI Provider (OpenRouter - FREE Models Only)
# Multiple models can be supplied as comma-separated lists to define priority failover pools.
# If a model encounters a transient 429 / 503 / timeout / unavailability error, the AI Gateway
# will automatically fail over to the next candidate free model in sequence.
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free
AI_PLANNING_MODEL=z-ai/glm-5.2:free,openai/gpt-oss-20b:free,google/gemma-4-31b-it:free,openrouter/free
AI_AGENT_MODEL=openai/gpt-oss-20b:free,google/gemma-4-31b-it:free,minimax/minimax-m3:free,openrouter/free
AI_REASONING_MODEL=z-ai/glm-5.2:free,openai/gpt-oss-20b:free,google/gemma-4-31b-it:free,openrouter/free
AI_GATEWAY_TIMEOUT_MS=60000
